# ========================================
# 应用配置
# ========================================
APP_NAME="FastAPI Backend Tutorial"
APP_VERSION="1.0.0"
DEBUG=True

# ========================================
# 数据库配置
# ========================================
# SQLite（开发环境）
DATABASE_URL="sqlite+aiosqlite:///./tutorial.db"

# PostgreSQL（生产环境推荐）
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/dbname"

DATABASE_ECHO=False

# ========================================
# JWT 配置
# ========================================
# ⚠️ 重要：生产环境必须修改此密钥！
# 生成方法: openssl rand -hex 32
SECRET_KEY="secret-key-noah"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440  # 24小时

# ========================================
# CORS 配置
# ========================================
# 允许的前端地址（JSON格式）
CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# ========================================
# 日志配置
# ========================================
LOG_LEVEL="INFO"

# ========================================
# SMTP / 邮件（可选）
# ========================================
# 留空 SMTP_HOST = 自动 dry-run，不连外网，CI / 本地都能跑 demo
# 真发时取消注释，并换成你的 SMTP。密码不要提交到 Git。
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="FastAPI Tutorial <noreply@example.com>"
SMTP_STARTTLS=True
SMTP_USE_TLS=False
SMTP_TIMEOUT=15
SMTP_DRY_RUN=False
EMAIL_FRONTEND_BASE_URL="https://example.com"

# 本机抓信（Mailhog / Mailpit）示例：
# SMTP_HOST="localhost"
# SMTP_PORT=1025
# SMTP_STARTTLS=False
# SMTP_USE_TLS=False

# ========================================
# 文件上传 / 分片（可选，有默认值）
# ========================================
# UPLOAD_DIR="data/uploads"
# MAX_UPLOAD_SIZE=10485760              # 单次上传 10MB
# CHUNKED_MAX_FILE_SIZE=104857600       # 分片整文件 100MB
# CHUNKED_DEFAULT_CHUNK_SIZE=1048576    # 默认每片 1MB
# CHUNKED_MAX_CHUNK_SIZE=5242880        # 单片上限 5MB
# CHUNKED_SESSION_TTL_SECONDS=86400     # 会话 24 小时后过期
